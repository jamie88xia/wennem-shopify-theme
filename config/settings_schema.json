[
  {
    "name": "theme_info",
    "theme_name": "WENNEM",
    "theme_version": "1.0.0",
    "theme_author": "WENNEM",
    "theme_documentation_url": "https://wennem.myshopify.com",
    "theme_support_url": "https://wennem.myshopify.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "WENNEM"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 130
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Primary background",
        "default": "#F8F6F2"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Secondary background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#C6A66A"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#ECE9E3"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "info": "Stand-in for \"Atteron\" (thin, high-contrast serif) using Shopify's built-in font library. Swap this if Atteron turns out to be a licensed font you need to upload separately.",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "label": "Base font size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section spacing",
        "min": 48,
        "max": 140,
        "step": 4,
        "unit": "px",
        "default": 88
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1120,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "options": [
          {
            "value": "solid",
            "label": "Solid primary"
          },
          {
            "value": "outline",
            "label": "Outline primary"
          }
        ],
        "default": "solid"
      },
      {
        "type": "select",
        "id": "product_card_ratio",
        "label": "Product image ratio",
        "options": [
          {
            "value": "3 / 4",
            "label": "Portrait"
          },
          {
            "value": "4 / 5",
            "label": "Tall portrait"
          },
          {
            "value": "1 / 1",
            "label": "Square"
          }
        ],
        "default": "4 / 5"
      }
    ]
  },
  {
    "name": "Commerce",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_product_badges",
        "label": "Show product badges",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold in cents",
        "default": 25000
      }
    ]
  },
  {
    "name": "Promotion",
    "settings": [
      {
        "type": "checkbox",
        "id": "promo_enabled",
        "label": "Enable signup promotion",
        "info": "Controls both the first-visit popup and the shop page banner.",
        "default": true
      },
      {
        "type": "text",
        "id": "promo_heading",
        "label": "Heading",
        "default": "15% off your first order"
      },
      {
        "type": "textarea",
        "id": "promo_body",
        "label": "Body copy",
        "default": "Sign up and get 15% off orders over $100."
      },
      {
        "type": "text",
        "id": "promo_cta_label",
        "label": "Shop page button label",
        "default": "Get 15% off"
      },
      {
        "type": "text",
        "id": "promo_success_message",
        "label": "Success message",
        "default": "You're in. Here's your code:"
      },
      {
        "type": "text",
        "id": "promo_discount_code",
        "label": "Discount code",
        "info": "Must match a real discount code created in Shopify Admin > Discounts (15% off, $100 minimum). Leave blank until that code exists."
      }
    ]
  }
]
