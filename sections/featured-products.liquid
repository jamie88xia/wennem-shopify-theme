{% liquid
  assign collection = section.settings.collection
  assign product_count = collection.products_count | default: 0
  assign featured_product = collection.products.first
%}

<section class="section featured-products featured-products--{{ section.settings.layout_style }}">
  <div class="page-width">
    {% unless product_count == 1 and featured_product %}
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          <h2>{{ section.settings.heading }}</h2>
          {% if section.settings.copy != blank %}
            <p>{{ section.settings.copy }}</p>
          {% endif %}
        </div>
        {% if section.settings.link_label != blank %}
          <a class="button" href="{{ section.settings.link | default: '/collections/products' }}">{{ section.settings.link_label }}</a>
        {% endif %}
      </div>
    {% endunless %}

    {% if product_count == 1 and featured_product %}
      {% liquid
        assign color_option = blank
        assign color_position = 0

        for option in featured_product.options_with_values
          assign option_name = option.name | downcase
          if option_name contains 'color' or option_name contains 'colour'
            assign color_option = option
            assign color_position = option.position
            break
          endif
        endfor
      %}

      {% if section.settings.layout_style == 'banner' %}
        <div class="featured-banner">
          <a class="featured-banner__media fade-in" href="{{ featured_product.url }}" aria-label="{{ featured_product.title | escape }}">
            {% if featured_product.featured_image %}
              {{ featured_product.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw', alt: featured_product.featured_image.alt | default: featured_product.title }}
            {% else %}
              <img src="{{ 'wennem-product-black-placeholder.png' | asset_url }}" width="1086" height="1448" loading="lazy" alt="{{ featured_product.title | escape }}">
            {% endif %}
          </a>

          <div class="featured-banner__content fade-in">
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
            <h2>{{ section.settings.heading }}</h2>
            {% if section.settings.copy != blank %}
              <p>{{ section.settings.copy }}</p>
            {% endif %}
            {% if section.settings.show_button and section.settings.product_button_label != blank %}
              <a class="button button--primary" href="{{ featured_product.url }}">{{ section.settings.product_button_label }}</a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="featured-single">
          <div class="featured-single__content fade-in">
            <div class="featured-single__intro">
              <p class="eyebrow">{{ section.settings.eyebrow }}</p>
              <h2>{{ section.settings.heading }}</h2>
              {% if section.settings.copy != blank %}
                <p>{{ section.settings.copy }}</p>
              {% endif %}
            </div>

            <div>
              <p class="eyebrow">{{ section.settings.product_eyebrow }}</p>
              <h3>{{ featured_product.title }}</h3>
              {% if section.settings.product_copy != blank %}
                <p>{{ section.settings.product_copy }}</p>
              {% endif %}
              {% if section.settings.show_price %}
                <div class="featured-single__price">
                  {% render 'price-display', product: featured_product, variant: featured_product.selected_or_first_available_variant %}
                </div>
              {% endif %}
            </div>

            {% if section.settings.show_button and section.settings.product_button_label != blank %}
              <a class="button button--primary" href="{{ featured_product.url }}">{{ section.settings.product_button_label }}</a>
            {% endif %}
          </div>

          {% if color_position > 0 %}
            <div class="featured-single__colorways featured-single__colorways--gallery" aria-label="{{ color_option.name | escape }}">
              {% for value in color_option.values %}
                {% liquid
                  assign option_key = 'option' | append: color_position
                  assign color_variant = blank
                  for variant in featured_product.variants
                    if variant[option_key] == value
                      assign color_variant = variant
                      break
                    endif
                  endfor
                  assign swatch_name = value | downcase
                  assign placeholder_image = 'wennem-product-black-placeholder.png'
                  if swatch_name contains 'beige' or swatch_name contains 'cream' or swatch_name contains 'ivory'
                    assign placeholder_image = 'wennem-product-beige-placeholder.png'
                  elsif swatch_name contains 'brown' or swatch_name contains 'espresso'
                    assign placeholder_image = 'wennem-product-espresso-placeholder.png'
                  endif
                %}
                <a class="colorway-card colorway-card--gallery" href="{{ featured_product.url }}{% if color_variant %}?variant={{ color_variant.id }}{% endif %}">
                  <span class="colorway-card__media">
                    <img src="{{ placeholder_image | asset_url }}" width="1086" height="1448" loading="lazy" alt="{{ value | escape }}">
                  </span>
                  <span class="colorway-card__footer">
                    <span
                      class="colorway-card__swatch"
                      style="--swatch: {% if swatch_name contains 'black' %}#151515{% elsif swatch_name contains 'beige' or swatch_name contains 'cream' or swatch_name contains 'ivory' %}#E7D9C7{% elsif swatch_name contains 'brown' or swatch_name contains 'espresso' %}#4A3328{% else %}#C6A66A{% endif %};"
                      aria-hidden="true"
                    ></span>
                    <span class="colorway-card__label">{{ value }}</span>
                  </span>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="product-grid">
        {% if product_count > 0 %}
          {% for product in collection.products limit: section.settings.limit %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% assign placeholder_images = 'wennem-product-black-placeholder.png,wennem-product-beige-placeholder.png,wennem-product-espresso-placeholder.png' | split: ',' %}
          {% assign placeholder_titles = 'Petite Straight Trouser, Black|Petite Straight Trouser, Soft Beige|Petite Straight Trouser, Espresso' | split: '|' %}
          {% for placeholder_image in placeholder_images %}
            <a class="product-card product-card--placeholder fade-in" href="{{ section.settings.link | default: '/collections/pre-order' }}">
              <div class="product-card__media">
                <img src="{{ placeholder_image | asset_url }}" width="1086" height="1448" alt="{{ placeholder_titles[forloop.index0] }}">
              </div>
              <div class="product-card__info">
                <span class="product-card__title">{{ placeholder_titles[forloop.index0] }}</span>
                <span class="product-card__meta">Petite proportions</span>
                <span class="product-card__price">$198</span>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The refined essentials edit." },
    { "type": "textarea", "id": "copy", "label": "Intro copy", "default": "One precise trouser, offered in considered neutrals for workdays, dinners, and everything between." },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Single product layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "Product-led split" },
        { "value": "banner", "label": "Editorial banner" }
      ]
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "product_eyebrow", "label": "Single product eyebrow", "default": "The first WENNEM trouser" },
    { "type": "textarea", "id": "product_copy", "label": "Single product copy", "default": "Designed from the first pattern for petite proportions, with a clean tailored fit and multiple inseams from day one." },
    { "type": "checkbox", "id": "show_button", "label": "Show single product button", "default": true },
    { "type": "text", "id": "product_button_label", "label": "Single product button label", "default": "Shop pre-order" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
