<section class="story-page" data-story-section>
  <div class="story-hero">
    <div class="page-width story-hero__grid">
      <div class="story-hero__copy fade-in">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.intro }}</p>
        {% if section.settings.button_label != blank %}
          <a class="button button--primary" href="{{ section.settings.button_link | default: '/collections/pre-order' }}">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
      <div class="story-hero__media fade-in">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 48vw, 100vw', alt: section.settings.heading }}
        {% else %}
          <img src="{{ 'wennem-hero-atelier.png' | asset_url }}" width="1536" height="1024" alt="{{ section.settings.heading | escape }}">
        {% endif %}
      </div>
    </div>
  </div>

  <div class="section story-founder">
    <div class="page-width story-founder__grid">
      <div class="story-founder__portrait fade-in">
        {% if section.settings.founder_image != blank %}
          {{ section.settings.founder_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 32vw, 100vw', alt: section.settings.founder_name }}
        {% else %}
          <img src="{{ 'tina-wang-headshot.jpg' | asset_url }}" width="1200" height="1600" loading="lazy" alt="{{ section.settings.founder_name | escape }}">
        {% endif %}
      </div>
      <div class="story-founder__note fade-in">
        <p class="eyebrow">{{ section.settings.founder_label }}</p>
        <h2>{{ section.settings.founder_heading }}</h2>
        <div class="rte story-founder__body">
          {{ section.settings.founder_note | newline_to_br }}
        </div>
        <p class="story-founder__signature">{{ section.settings.founder_name }}</p>
        <p class="story-founder__title">{{ section.settings.founder_title }}</p>
      </div>
    </div>
  </div>

  <div class="section story-chapters">
    <div class="page-width">
      <div class="story-chapters__header">
        <p class="eyebrow">{{ section.settings.chapter_eyebrow }}</p>
        <h2>{{ section.settings.chapter_heading }}</h2>
      </div>

      <div class="story-slider" data-story-slider data-interval="{{ section.settings.slide_interval | times: 1000 }}">
        <div class="story-slider__viewport" aria-live="polite">
          {% for block in section.blocks %}
            <article class="story-slide{% if forloop.first %} is-active{% endif %}" data-story-slide data-story-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
              <p class="story-slide__kicker">Chapter {{ forloop.index }} · {{ block.settings.chapter_title }}</p>
              <h3>{{ block.settings.heading }}</h3>
              <div class="story-slide__body">{{ block.settings.body | newline_to_br }}</div>
            </article>
          {% else %}
            <article class="story-slide is-active" data-story-slide data-story-index="0">
              <p class="story-slide__kicker">Chapter 1 · The Origin</p>
              <h3>Growing up, going back to Taiwan always meant one thing: shopping.</h3>
              <div class="story-slide__body">Every trip home, I found clothes that fit the way I wanted them to. The quality was there, the proportions made sense, and I felt confident without having to think twice.</div>
            </article>
          {% endfor %}
        </div>

        <div class="story-slider__controls" aria-label="Story chapters">
          <button class="story-slider__arrow" type="button" data-story-prev aria-label="Previous chapter">‹</button>
          <div class="story-slider__dots">
            {% for block in section.blocks %}
              <button class="story-slider__dot{% if forloop.first %} is-active{% endif %}" type="button" data-story-dot data-story-index="{{ forloop.index0 }}" aria-label="Show chapter {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="visually-hidden">Chapter {{ forloop.index }}</span>
              </button>
            {% endfor %}
          </div>
          <button class="story-slider__arrow" type="button" data-story-next aria-label="Next chapter">›</button>
        </div>
      </div>
    </div>
  </div>


  <div class="section story-build">
    <div class="page-width story-build__grid">
      <div>
        <p class="eyebrow">{{ section.settings.promise_eyebrow }}</p>
        <h2>{{ section.settings.promise_heading }}</h2>
      </div>
      <div class="story-build__list">
        <p>{{ section.settings.promise_intro }}</p>
        <ul>
          <li>{{ section.settings.promise_1 }}</li>
          <li>{{ section.settings.promise_2 }}</li>
          <li>{{ section.settings.promise_3 }}</li>
          <li>{{ section.settings.promise_4 }}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="section story-cta">
    <div class="page-width story-cta__inner">
      <h2>{{ section.settings.closing_heading }}</h2>
      <p>{{ section.settings.closing_copy }}</p>
      {% if section.settings.button_label != blank %}
        <a class="button button--primary" href="{{ section.settings.button_link | default: '/collections/pre-order' }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Hero heading", "default": "You shouldn’t have to settle for almost." },
    { "type": "textarea", "id": "intro", "label": "Hero intro", "default": "WENNEM began with a feeling I could not shake: I had worn clothes that truly fit, and I knew women here deserved that same standard." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder image" },
    { "type": "text", "id": "founder_label", "label": "Founder label", "default": "A note from our founder" },
    { "type": "text", "id": "founder_heading", "label": "Founder heading", "default": "I started WENNEM for the women who know exactly what’s missing." },
    { "type": "textarea", "id": "founder_note", "label": "Founder note", "default": "Growing up, every trip back to Taiwan meant shopping. I would come home with pieces that fit beautifully, felt considered, and made me feel like myself. My friends in the States always noticed. Where did you get that?\n\nYears later, after college in New York and then building my career, I kept running into the same problem: the clean, effortless pieces I wanted rarely fit without compromise. I was tired of tailoring, returning, and settling for almost.\n\nAfter my daughter was born in January 2026, that old frustration became something I could no longer ignore. I wanted to build something for me, for her, and for every woman who has known the difference between clothes that fit and clothes that only come close." },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Tina Wang" },
    { "type": "text", "id": "founder_title", "label": "Founder title", "default": "CEO of WENNEM" },
    { "type": "text", "id": "chapter_eyebrow", "label": "Chapter eyebrow", "default": "The beginning" },
    { "type": "text", "id": "chapter_heading", "label": "Chapter heading", "default": "Six chapters that shaped WENNEM." },
    { "type": "range", "id": "slide_interval", "label": "Seconds between chapter slides", "min": 5, "max": 15, "step": 1, "default": 10 },
    { "type": "text", "id": "promise_eyebrow", "label": "Promise eyebrow", "default": "What we’re building" },
    { "type": "text", "id": "promise_heading", "label": "Promise heading", "default": "Trousers first, because the problem is clearest there." },
    { "type": "textarea", "id": "promise_intro", "label": "Promise intro", "default": "WENNEM starts with the pieces that have to work hardest: refined trousers made for women who are done working around fit." },
    { "type": "text", "id": "promise_1", "label": "Promise 1", "default": "Waist and hips considered together." },
    { "type": "text", "id": "promise_2", "label": "Promise 2", "default": "Multiple inseam lengths from day one." },
    { "type": "text", "id": "promise_3", "label": "Promise 3", "default": "Machine-washable, wrinkle-resistant fabrics." },
    { "type": "text", "id": "promise_4", "label": "Promise 4", "default": "Consistent sizing you can come back to." },
    { "type": "text", "id": "closing_heading", "label": "Closing heading", "default": "For women who know exactly what’s missing." },
    { "type": "textarea", "id": "closing_copy", "label": "Closing copy", "default": "You shouldn’t have to settle for almost. That’s the whole point." },
    { "type": "text", "id": "button_label", "label": "CTA label", "default": "Shop pre-order" },
    { "type": "url", "id": "button_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "text", "id": "chapter_title", "label": "Chapter title", "default": "The Origin" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Growing up, going back to Taiwan always meant one thing: shopping." },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Every trip home led me back to the same neighborhoods, where the fit was right, the quality was there, and I felt confident in what I was wearing. My friends always noticed when I came back. Where did you get that? I loved that question. I still do." }
      ]
    }
  ]
}
{% endschema %}
