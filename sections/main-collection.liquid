<section class="collection-hero">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a> / <span>{{ collection.title }}</span>
    </nav>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}
    <div class="collection-toolbar">
      <p class="product-count">{{ collection.products_count }} products</p>
      <a class="button" href="{{ routes.collections_url }}/pre-order">Pre-order</a>
    </div>

    {% if settings.promo_enabled %}
      <div class="promo-banner">
        <p><strong>{{ settings.promo_heading }}</strong> — {{ settings.promo_body }}</p>
        <button type="button" class="button" data-open-signup-popup>{{ settings.promo_cta_label }}</button>
      </div>
    {% endif %}
  </div>
</section>

<section class="page-width collection-layout collection-layout--minimal{% unless collection.filters.size > 0 %} collection-layout--unfiltered{% endunless %}">
  {% if collection.filters.size > 0 %}
    <aside class="filter-panel filter-panel--minimal" aria-label="Collection filters">
      <form>
        {% for filter in collection.filters %}
          <details class="filter-group" open>
            <summary>{{ filter.label }} <span>+</span></summary>
            <div class="filter-values">
              {% for value in filter.values %}
                <label>
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <span>{{ value.label }}{% unless value.count == 0 %} ({{ value.count }}){% endunless %}</span>
                </label>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
        <button class="button button--full" type="submit">Apply</button>
      </form>
    </aside>
  {% endif %}

  <div>
    {% paginate collection.products by section.settings.products_per_page %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>No products found.</p>
        {% endfor %}
      </div>

      {% if paginate.next %}
        <div class="load-more">
          <a class="button" href="{{ paginate.next.url }}">Load more</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
